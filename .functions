function fhf() {
  find . -type f | while read f; do
    # Skip if no extension or extension matches common patterns
    [[ "$f" =~ \.([^.]+)$ ]] || continue
    ext="${BASH_REMATCH[1]}"

    # Get file type using file command
    type=$(file -b --mime-type "$f" 2>/dev/null)
    [[ -z "$type" ]] && continue

    # Map common mime types to expected extensions
    declare -A type_map=(
      ["image/jpeg"]="jpg jpeg"
      ["image/png"]="png"
      ["image/gif"]="gif"
      ["image/webp"]="webp"
      ["image/bmp"]="bmp"
      ["image/tiff"]="tif tiff"
      ["text/plain"]="txt"
      ["text/html"]="html htm"
      ["application/pdf"]="pdf"
      ["application/zip"]="zip"
      ["application/x-rar"]="rar"
      ["application/x-gzip"]="gz"
      ["application/x-bzip2"]="bz2"
      ["application/x-tar"]="tar"
      ["audio/mpeg"]="mp3"
      ["audio/wav"]="wav"
      ["audio/flac"]="flac"
      ["video/mp4"]="mp4"
      ["video/x-matroska"]="mkv"
      ["video/x-msvideo"]="avi"
      ["application/x-mpegURL"]="m3u8"
    )

    expected="${type_map[$type]}"
    if [[ -n "$expected" ]]; then
      # Check if extension is not in expected list
      if ! [[ " $expected " =~ " $ext " ]]; then
        echo "MISMATCH: Type: $type, Expected: .{$expected}, Actual: .$ext"
        echo "  File: $f"
        echo
      fi
    fi
  done
}


function gsub(){
    echo "s $1 -l $3 | xargs sed -i '' s=$1=$2=g"
    s $1 -l $3 | xargs sed -i '' s=$1=$2=g
}

function fix_pg(){
    rm /usr/local/var/postgres/postmaster.pid
    launchctl unload homebrew.mxcl.postgresql.plist
    launchctl load -w homebrew.mxcl.postgresql.plist
}

function rgm(){
    echo "rails g model $*"
    rails g model $*
}

function rge(){
    echo "rails g entity $*"
    rails g entity $*
}

function bk(){
    filename="${1%%.*}"
    extension="${1##*.}"

    echo "cp $1 $filename.bk.$extension"
    cp $1 $filename.bk.$extension
}

function bkrm(){
    bk
    echo "rm $1"
    rm $1
}

function bku(){
    filename="${1%%.*}"
    extension="${1##*.}"

    echo "cp $filename.bk.$extension $1"
    cp $filename.bk.$extension $1

    echo "rm $filename.bk.$extension"
    rm $filename.bk.$extension
}

function ff(){
  echo "find $2 | grep $1"
  find $2 | grep $1
}

function sss() {
  cp ~/Desktop/"$(ls ~/Desktop | grep "Screen Shot 2.*png" | tail -1)" $1
}

# sequelize
function sqz(){
  yarn sequelize $* --config apps/dodo/backend/db/config.json --options-path apps/dodo/backend/.sequelizerc
}

function gro(){
  gxm
  git fetch origin $1
  gx $1
  git reset --hard origin/$1
}

function wcwpp(){
  cp -r ~/wordable/wordpress/wp-6.4.3/wp-content/plugins/wordable/* ~/wordable/w2/wordpress-plugin-svn/trunk/
  rm ~/wordable/w2/wordpress-plugin-svn/trunk/host
}

function wrcwpp(){
  cp -r ~/wordable/wordpress/wp-content/plugins/wordable/* ~/wordable/w2/wordpress-plugin-svn/trunk/
}